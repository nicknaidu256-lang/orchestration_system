      "outputs": ["summary_written"],
      "idempotent": true,
      "retryable": false,
      "requires_approval": false
    },
    {
      "id": "step_5",
      "capability": "file_write",
      "inputs": {
        "path": "output/print_summary.py",
        "content": "$python_script"
